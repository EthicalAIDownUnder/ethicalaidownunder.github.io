---
import type { CollectionEntry } from "astro:content";
import { formatShortDate, withBase } from "../lib/url";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const href = withBase(`/blog/${post.id}/`);
---
<article class="card content-card">
  <div class="card__meta">
    <span>{formatShortDate(post.data.pubDate)}</span>
    {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
  </div>
  <h3><a href={href}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <a class="text-link" href={href}>Read insight</a>
</article>
