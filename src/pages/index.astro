---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import EventCard from "../components/EventCard.astro";
import BlogCard from "../components/BlogCard.astro";
import ResourceCard from "../components/ResourceCard.astro";
import CTASection from "../components/CTASection.astro";
import { siteConfig } from "../data/site";
import { withBase } from "../lib/url";

const events = (await getCollection("events", ({ data }) => !data.draft))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const resources = (await getCollection("resources", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 1);

const focusAreas = [
  {
    title: "Responsible AI research and dialogue",
    text: "Create space for practical, evidence-informed discussion about AI ethics, governance and real-world impact."
  },
  {
    title: "AI literacy and public awareness",
    text: "Help communities understand AI systems, ask better questions and participate in decisions that affect them."
  },
  {
    title: "Events, webinars and workshops",
    text: "Bring people together through accessible learning sessions, expert panels and hands-on conversations."
  },
  {
    title: "Youth and early-career engagement",
    text: "Support the next generation to think critically about technology, responsibility and social outcomes."
  },
  {
    title: "Policy, standards and advocacy",
    text: "Contribute to responsible AI conversations across government, education, industry and civil society."
  },
  {
    title: "Community and industry collaboration",
    text: "Connect researchers, technologists, educators, policymakers and the public around shared ethical AI goals."
  }
];
---
<BaseLayout>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="eyebrow">Non-profit initiative - Adelaide, Australia and beyond</p>
        <h1>Advancing responsible, human-centred AI.</h1>
        <p class="hero__lead">
          Ethical AI Down Under brings together researchers, technologists, educators, policymakers, industry professionals and community members to help shape AI systems that are safe, fair, transparent and aligned with human values.
        </p>
        <div class="hero__actions">
          <a class="button" href={withBase("/get-involved/")}>Join the movement</a>
          <a class="button button--secondary" href={siteConfig.subscribeUrl}>Subscribe to updates</a>
        </div>
        <p class="hero__note">Ethical AI is not just a technical challenge. It is a human, social and civic responsibility.</p>
      </div>

      <div class="hero-card" aria-label="Ethical AI Down Under focus summary">
        <img src={withBase("/assets/eaid-logo.png")} alt="Ethical AI Down Under logo" />
        <div class="principle-grid">
          <span>Safe</span>
          <span>Transparent</span>
          <span>Inclusive</span>
          <span>Accountable</span>
        </div>
        <p>Rooted in Australia, connected to global conversations, and focused on practical public benefit.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2>A community for ethical, transparent and trustworthy AI.</h2>
      </div>
      <div class="prose-lite">
        <p>
          We work at the intersection of technology, ethics, policy and society. Our role is to convene people who care about the future of AI and translate complex questions into accessible, useful and responsible action.
        </p>
        <p>
          Based in Adelaide, we support conversations across Australia and beyond - from public AI literacy and youth engagement to professional knowledge sharing, research discussion and responsible AI advocacy.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container two-cards">
      <article class="statement-card">
        <p class="eyebrow">Mission</p>
        <h2>Advance ethical, transparent and human-centred AI.</h2>
        <p>We do this through research, education, collaboration and public awareness.</p>
      </article>
      <article class="statement-card statement-card--dark">
        <p class="eyebrow">Vision</p>
        <h2>AI developed and used responsibly, equitably and in service of people.</h2>
        <p>We believe technology should strengthen public trust, human dignity and shared prosperity.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="What we do"
        title="Practical programs for a responsible AI future"
        description="The website is designed to grow with the organisation: start with community, events and resources, then add publications, gallery, webinars, podcast and member workflows over time."
        align="center"
      />
      <div class="card-grid card-grid--three">
        {focusAreas.map((item) => (
          <article class="feature-card">
            <div class="feature-card__icon" aria-hidden="true"></div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <SectionHeader eyebrow="Events" title="Upcoming conversations" description="Workshops, webinars, roundtables and community events will appear here as the program develops." />
      <div class="card-grid card-grid--three">
        {events.map((event) => <EventCard event={event} />)}
      </div>
      <div class="section-action">
        <a class="text-link" href={withBase("/events/")}>View all events</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Knowledge hub" title="Latest insights and resources" description="A growing library of plain-language explainers, practical guides and thought leadership." />
      <div class="card-grid card-grid--three">
        {posts.map((post) => <BlogCard post={post} />)}
        {resources.map((resource) => <ResourceCard resource={resource} />)}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
