---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { formatDate } from "../../lib/url";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <PageHero eyebrow={formatDate(post.data.pubDate)} title={post.data.title} description={post.data.description} />

  <section class="section">
    <div class="container content-layout content-layout--article">
      <aside class="details-panel" aria-label="Article details">
        <h2>Article details</h2>
        <dl>
          <div><dt>Author</dt><dd>{post.data.author}</dd></div>
          <div><dt>Published</dt><dd>{formatDate(post.data.pubDate)}</dd></div>
          {post.data.updatedDate && <div><dt>Updated</dt><dd>{formatDate(post.data.updatedDate)}</dd></div>}
          {post.data.tags.length > 0 && <div><dt>Tags</dt><dd>{post.data.tags.join(", ")}</dd></div>}
        </dl>
      </aside>
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>
