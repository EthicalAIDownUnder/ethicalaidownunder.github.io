---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Privacy" description="Ethical AI Down Under privacy information.">
  <PageHero eyebrow="Privacy" title="Privacy and data use" description="A simple starting privacy statement for the first public launch." />

  <section class="section">
    <div class="container prose">
      <h2>Current website setup</h2>
      <p>This starter website is static. It does not include advertising pixels, analytics scripts, tracking cookies, payment processing or a database by default.</p>

      <h2>Email and forms</h2>
      <p>Initial Join, Subscribe and Contact links use email. If you choose to connect a newsletter, CRM, analytics service or form provider later, update this page to explain what information is collected, why it is collected, how it is stored and how people can unsubscribe or request changes.</p>

      <h2>Future updates</h2>
      <p>This page should be reviewed before launching any mailing list, member database, donation platform, CRM, event registration tool or analytics integration.</p>
    </div>
  </section>
</BaseLayout>
